{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Isaac Lab: Train Go2",
            "type": "debugpy",
            "request": "launch",
            "module": "isaaclab",
            "args": ["train", "--rl_library", "rsl_rl", "--task", "RobotLab-Isaac-Velocity-Flat-Unitree-Go2-v0", "--num_envs", "64", "--viz", "none", "physics=newton_mjwarp"],
            "console": "integratedTerminal"
        },
        {
            "name": "Isaac Lab: Play Go2",
            "type": "debugpy",
            "request": "launch",
            "module": "isaaclab",
            "args": ["play", "--rl_library", "rsl_rl", "--task", "RobotLab-Isaac-Velocity-Flat-Unitree-Go2-v0", "--num_envs", "4", "--checkpoint", "latest", "--viz", "newton_gl", "physics=newton_mjwarp"],
            "console": "integratedTerminal"
        }
    ]
}
